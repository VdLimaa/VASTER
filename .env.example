# Conexão com o Postgres. O docker-compose sobe exatamente este banco.
VASTER_DB_DSN=postgresql://vaster:vaster@localhost:5432/vaster

# Base da API do TCGdex. Não precisa de chave.
TCGDEX_BASE=https://api.tcgdex.net/v2

# Idioma do overlay traduzido.
# ATENÇÃO: é 'pt', não 'pt-br'. Ver docs/achados-tcgdex.md — em pt-br o TCGdex
# só tem Pokémon TCG Pocket (app), não o card game físico.
TCGDEX_LANG_PT=pt
TCGDEX_LANG_EN=en

# Requisições simultâneas contra o TCGdex. Mantenha baixo: a API é gratuita.
TCGDEX_CONCURRENCY=6
TCGDEX_TIMEOUT=30

# Base da PokéAPI, usada só para a lista de espécies.
POKEAPI_BASE=https://pokeapi.co/api/v2
